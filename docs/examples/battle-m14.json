{
  // 1.5 M14 try-out: the flying slime (S5) and the burrowing slime (S6). They are in the built-in data but
  // no battle uses them yet (chapter 2 and Infinity bring them in). Copy this file to
  // %LOCALAPPDATA%\DesktopPet\battle.json (keep a copy of yours first), then Battle Mode → Start battle
  // (the free battle). Custom data: no records, no rewards. Delete the file to get the usual free battle
  // back. Flying slime: carry the cat up to it (the cat swings by itself), Push it or yank it with the
  // Grabber, then hit it on the floor. Burrowing slime: lift the cat when the cracks show and let go onto
  // them, or pull it up with the Grabber.
  "schemaVersion": 1,
  "maxAlive": 5,
  "waves": [
    { "groups": [ { "enemy": "flyer", "count": 1 }, { "enemy": "slime", "count": 2 } ] },
    { "groups": [ { "enemy": "burrower", "count": 2 }, { "enemy": "slime", "count": 1 } ] },
    { "groups": [ { "enemy": "flyer", "count": 1 }, { "enemy": "burrower", "count": 1 }, { "enemy": "runner", "count": 2 } ] },
    { "groups": [ { "enemy": "flyer", "count": 2, "elite": true }, { "enemy": "burrower", "count": 1, "elite": true } ] }
  ]
}

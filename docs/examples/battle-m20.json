{
  // 1.5 M20 try-out, defence rules since 2026-11-13: a stage with a fish basket that has HP. Copy this file
  // to a test data folder (or %LOCALAPPDATA%\DesktopPet\battle.json after keeping a copy of yours), then
  // Battle Mode → Adventure: this file's chapter stands in for chapter 1 while it is there (custom data: no
  // progress, no records, no rewards). Delete the file to get the usual Adventure back. The basket stands
  // in the middle of the strip; slimes come from both edges and hit it with their own blows. Each slime the
  // cat hits turns on the cat for "aggro" s (every hit starts that again), then goes back for the basket.
  // The basket broken loses the stage, whatever HP the cat has left.
  "schemaVersion": 1,
  "campaign": {
    "chapters": [
      {
        "id": "m20", "nameVi": "Thử giỏ cá", "nameEn": "Fish basket try-out", "skillChoice": true,
        "stages": [
          {
            "id": "m20_basket", "nameVi": "Bảo vệ giỏ cá", "nameEn": "Defend the basket",
            "goalVi": "Slime hai bên đánh giỏ: đánh trúng con nào thì con đó quay sang mèo",
            "goalEn": "Slimes from both sides hit the basket: each one the cat hits turns on the cat",
            "basket": { "hp": 150 }, "maxAlive": 5,
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 4 } ] },
              { "groups": [ { "enemy": "slime", "count": 3 }, { "enemy": "runner", "count": 2 } ] },
              { "groups": [ { "enemy": "slime", "count": 3 }, { "enemy": "rock", "count": 1 }, { "enemy": "runner", "count": 2 } ] }
            ]
          },
          {
            "id": "m20_basket_hold", "nameVi": "Giữ giỏ 60 giây", "nameEn": "Hold the basket 60 s",
            "goalVi": "Sống sót 60 giây mà giỏ không vỡ", "goalEn": "Survive 60 s without the basket breaking",
            "objective": "survive", "surviveSeconds": 60, "basket": { "hp": 120, "aggro": 3 }, "maxAlive": 4,
            "waves": [ { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 1 } ] } ]
          }
        ]
      }
    ]
  }
}

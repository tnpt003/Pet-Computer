{
  // Battle Mode data (DIPs and seconds). Embedded in the exe; a broken file is logged and
  // the built-in battle is used (same numbers; only plain slimes before the King).
  // Misspelt keys are rejected. To change it without rebuilding, put a battle.json with only
  // your changes in %LOCALAPPDATA%\DesktopPet (see docs/BATTLE-DATA.md).
  "schemaVersion": 1,
  "catMaxHp": 100,
  // The cat runs during a battle (walking speed and acceleration × this).
  "catRunScale": 1.8,
  // Combo: this many hits in a row (each within comboWindow s of the last) make the last one
  // a combo: damage × comboDamage and a knock-back (DIPs/s, × the enemy's pushFactor). comboSplash: the
  // other enemies within comboSplashRadius DIPs of its target (edge to edge) take that share of its damage,
  // only those the swing reaches (in front of the cat, near edge within the weapon's range + 14 DIPs).
  "comboHits": 3,
  "comboWindow": 1.6,
  "comboDamage": 2,
  "comboKnock": 300,
  "comboSplash": 0.6,
  "comboSplashRadius": 60,
  // The cat's weapons, in the order the battle setup panel shows them (the first one is the
  // default). style: the drawing ("sword" or "hammer"). range: centre-to-centre reach.
  // attackCooldown: from one swing to the next; hitTime: the one moment in the swing that hits.
  // knock: every hit sends the slime back (DIPs/s × its pushFactor, no stun); 0 = only combos do.
  // stunChance: a landed hit dazes the enemy stunSeconds (× its stunFactor; never a boss) this often.
  "weapons": [
    {
      "id": "sword", "nameVi": "Kiếm", "nameEn": "Sword", "style": "sword", "hitEffect": "spark",
      "hintVi": "nhanh, dễ nối combo", "hintEn": "fast, easy combos",
      "damage": 25, "range": 76, "attackCooldown": 0.75, "swingDuration": 0.36, "hitTime": 0.16, "knock": 0, "stunChance": 0
    },
    {
      "id": "hammer", "nameVi": "Búa", "nameEn": "Hammer", "style": "hammer", "hitEffect": "thud",
      "hintVi": "chậm, mạnh, đẩy lùi mỗi nhát, đôi khi làm choáng", "hintEn": "slow, heavy, knocks back every hit, sometimes stuns",
      "damage": 45, "range": 76, "attackCooldown": 1.35, "swingDuration": 0.7, "hitTime": 0.45, "knock": 170, "stunChance": 0.15, "stunSeconds": 0.8
    },
    // 1.5 M08. sweep: every landed swing also hits every other enemy in reach; pull: DIPs/s a hit draws
    // a slime that keeps its distance (support kinds) toward the cat. comboHits: this weapon's chain
    // (2–6); launch: DIPs/s a combo hit tosses its enemy up, launchStun: its daze on landing (s).
    {
      "id": "yarn", "nameVi": "Cuộn len", "nameEn": "Yarn", "style": "yarn", "hitEffect": "spark",
      "hintVi": "tầm xa, quét mọi slime trong tầm, kéo slime đứng xa lại gần", "hintEn": "long reach, sweeps every slime in reach, pulls back-liners in",
      "damage": 14, "range": 114, "attackCooldown": 0.8, "swingDuration": 0.42, "hitTime": 0.2, "knock": 0, "stunChance": 0,
      "sweep": true, "pull": 420
    },
    {
      "id": "glove", "nameVi": "Găng đấm", "nameEn": "Glove", "style": "glove", "hitEffect": "spark",
      "hintVi": "rất nhanh, combo 5 nhát, nhát cuối hất tung slime", "hintEn": "very fast, 5-hit combo, the last hit launches the slime",
      "damage": 14, "range": 70, "attackCooldown": 0.38, "swingDuration": 0.22, "hitTime": 0.09, "knock": 0, "stunChance": 0,
      "comboHits": 5, "launch": 560, "launchStun": 0.8
    }
  ],

  "slimeWidth": 46,
  "slimeHeight": 34,
  "spawnDuration": 0.5,
  "defeatDuration": 0.6,
  "maxAlive": 3,
  "spawnInterval": 1.6,
  "firstWaveDelay": 1.5,
  "waveBreakSeconds": 3.5,
  "waveHeal": 15,
  "spawnMinDistance": 200,
  // Putting a lifted cat down protects it this long (0–5 s), at most once per
  // rescueGraceCooldownSeconds (0–60) of the cat on the ground in a running battle, and only after
  // a lift of at least rescueGraceMinLiftSeconds (0–2; a quick lift-and-drop earns none).
  "landingGraceSeconds": 1.5,
  "rescueGraceCooldownSeconds": 5,
  "rescueGraceMinLiftSeconds": 0.3,
  // A dashing slime that runs into the cat stuns it (stars over its head; it stands still and does
  // not swing, but can still be lifted and thrown). After a stun, no new one for stunImmunitySeconds.
  "stunDurationSeconds": 1.5,
  "stunImmunitySeconds": 3,
  // Attack turns: at most maxAttackers enemies wind up or dash at once (0: no limit) and a new windup
  // starts at least attackStagger s after the last (the boss never waits). incomingWarning: seconds
  // an arrow shows at an edge before a spawn from behind (two-sided waves, "side": "b").
  "maxAttackers": 2,
  "attackStagger": 0.3,
  "incomingWarning": 1,
  // Enemy Director: at most maxElites elite enemies alive at once (a stage's eliteChance rolls them,
  // never on Easy); rareChance: how often a group's rare card takes its common card's place.
  "maxElites": 1,
  "rareChance": 0.15,
  "utilityChance": 0.25,
  "outroSeconds": 3,
  "hurtFlashSeconds": 0.35,
  "maxEffects": 32,

  // The user's skills.
  "pushCooldown": 5,
  "pushSpeed": 520,
  "pushStunSeconds": 1.4,
  "healCooldown": 14,
  "healAmount": 25,
  "cheerCooldown": 18,
  "cheerSeconds": 5,
  "cheerSpeed": 1.6,
  "cheerDamage": 1.4,
  "bombCooldown": 12,
  "bombDelay": 0.5,
  "bombDamage": 30,
  "bombRadius": 70,
  "shieldCooldown": 15,
  "shieldSeconds": 3,
  // 1.5 Laser pointer: the dot's seconds, how far it lures slimes (DIPs), HP a second for a slime on
  // it. Fan: seconds of air, the refill once spent, its reach (DIPs), the wind's speed, a bump's damage.
  "laserCooldown": 14,
  "laserSeconds": 4,
  "laserLureRange": 300,
  "laserDps": 3,
  "fanSteamSeconds": 3,
  "fanRefillSeconds": 6,
  "fanRange": 200,
  "fanSpeed": 220,
  "fanBumpDamage": 4,
  // 1.5 Grabber: cooldown, the longest hold (s), the largest kind it lifts (scale), a throw's hit damage,
  // its daze (s), the cursor speed a let-go needs to be a throw (DIPs/s). Scissors: cooldown, a cut's
  // damage, the shortest stroke (DIPs). Spray: seconds of water, the refill once spent, its reach
  // around the cursor (DIPs), HP a second, how much slower (0–0.9), how long a slime stays wet (s).
  "grabberCooldown": 12,
  "grabberHoldSeconds": 3,
  "grabberMaxScale": 1.3,
  "grabberHitDamage": 8,
  "grabberStun": 1,
  "grabberThrowSpeed": 300,
  "scissorsCooldown": 8,
  "scissorsDamage": 6,
  "scissorsMinLength": 40,
  "sprayTankSeconds": 4,
  "sprayRefillSeconds": 8,
  "sprayRange": 70,
  "sprayDps": 2,
  "sprayChill": 0.35,
  "spraySoakSeconds": 1.5,
  // 1.5 M07 rage (clicked on its bar once full): its time (s), the bar gained by each landed swing of the cat
  // and by each HP it loses (both 0: it never fills), how much bigger the cat is drawn (1–1.4, drawing only),
  // a raging hit's knock back (× rageKnockFactor, at least rageKnock DIPs/s).
  "rageSeconds": 6,
  "rageHitGain": 0.05,
  "rageHurtGain": 0.012,
  "rageScale": 1.3,
  "rageKnock": 220,
  "rageKnockFactor": 1.5,
  // Their names and HUD descriptions (every skill once: push, heal, cheer, bomb, shield; the
  // HUD order and what each does stay in the app). {key} in a description is that number of
  // this file, e.g. {pushCooldown}. Names: at most 32 characters; descriptions: at most 220.
  "skills": [
    {
      "id": "push", "nameVi": "Đẩy quái", "nameEn": "Push",
      "descVi": "Đẩy quái — chọn rồi click một slime (nửa trái: đẩy sang phải, nửa phải: sang trái), choáng {pushStunSeconds} giây. Hồi {pushCooldown} giây.",
      "descEn": "Push — choose, then click a slime (left half: push right, right half: push left); stuns {pushStunSeconds} s. {pushCooldown} s cooldown."
    },
    {
      "id": "heal", "nameVi": "Cá hồi máu", "nameEn": "Healing fish",
      "descVi": "Cá hồi máu — mèo hồi {healAmount} HP. Hồi {healCooldown} giây.",
      "descEn": "Healing fish — the cat gets {healAmount} HP back. {healCooldown} s cooldown."
    },
    {
      "id": "cheer", "nameVi": "Cổ vũ", "nameEn": "Cheer",
      "descVi": "Cổ vũ — {cheerSeconds} giây mèo đánh nhanh ×{cheerSpeed}, mạnh ×{cheerDamage}. Hồi {cheerCooldown} giây.",
      "descEn": "Cheer — for {cheerSeconds} s the cat attacks ×{cheerSpeed} as often, ×{cheerDamage} as hard. {cheerCooldown} s cooldown."
    },
    {
      "id": "bomb", "nameVi": "Bom len", "nameEn": "Yarn bomb",
      "descVi": "Bom len — chọn rồi click một slime: nổ sau {bombDelay} giây, {bombDamage} sát thương cho mọi quái quanh đó. Hồi {bombCooldown} giây.",
      "descEn": "Yarn bomb — choose, then click a slime: bursts after {bombDelay} s for {bombDamage} damage to every slime nearby. {bombCooldown} s cooldown."
    },
    {
      "id": "shield", "nameVi": "Khiên bong bóng", "nameEn": "Bubble shield",
      "descVi": "Khiên bong bóng — {shieldSeconds} giây mèo không mất máu. Hồi {shieldCooldown} giây.",
      "descEn": "Bubble shield — for {shieldSeconds} s the cat takes no damage. {shieldCooldown} s cooldown."
    },
    // 1.5: the five new skills work since M05/M06 (free battles may carry them until chapter 2 opens them).
    {
      "id": "laser", "nameVi": "Đèn laser", "nameEn": "Laser pointer",
      "descVi": "Đèn laser — chọn rồi click một chỗ: {laserSeconds} giây slime gần đó chạy theo chấm đỏ, không đánh mèo; con trên chấm mất {laserDps} máu/giây. Hồi {laserCooldown} giây.",
      "descEn": "Laser pointer — choose, then click a spot: for {laserSeconds} s nearby slimes chase the red dot, not the cat; one on the dot loses {laserDps} HP/s. {laserCooldown} s cooldown."
    },
    {
      "id": "grabber", "nameVi": "Kẹp gắp", "nameEn": "Grabber",
      "descVi": "Kẹp gắp — chọn rồi nhấn giữ một slime nhỏ (không phải đá hay boss) và vung chuột để ném: trúng slime khác thì cả hai mất {grabberHitDamage} máu, con kia choáng. Hồi {grabberCooldown} giây.",
      "descEn": "Grabber — choose, then press a small slime (not a rock or a boss) and fling the mouse: thrown into another, both lose {grabberHitDamage} HP and the other is dazed. {grabberCooldown} s cooldown."
    },
    {
      "id": "scissors", "nameVi": "Kéo cắt", "nameEn": "Scissors",
      "descVi": "Kéo cắt — chọn rồi kéo chuột thành một nét: cắt đứt dây nhầy, slime nằm trên nét mất {scissorsDamage} máu. Hồi {scissorsCooldown} giây.",
      "descEn": "Scissors — choose, then drag a stroke: it cuts slime ropes, and each slime on it loses {scissorsDamage} HP. {scissorsCooldown} s cooldown."
    },
    {
      "id": "fan", "nameVi": "Quạt", "nameEn": "Fan",
      "descVi": "Quạt — chọn rồi giữ chuột: thổi slime ra xa con trỏ, va nhau hoặc va mép mất {fanBumpDamage} máu. Hơi đủ {fanSteamSeconds} giây; cạn thì chờ {fanRefillSeconds} giây.",
      "descEn": "Fan — choose, then hold the mouse: blows slimes away from the cursor; one blown into another or the edge loses {fanBumpDamage} HP. {fanSteamSeconds} s of air; empty, it refills in {fanRefillSeconds} s."
    },
    {
      "id": "spray", "nameVi": "Bình xịt nước", "nameEn": "Water spray",
      "descVi": "Bình xịt nước — chọn rồi giữ chuột: slime bị xịt ướt sũng, chậm lại, co nhỏ và mất {sprayDps} máu/giây. Nước đủ {sprayTankSeconds} giây; cạn thì chờ {sprayRefillSeconds} giây.",
      "descEn": "Water spray — choose, then hold the mouse: soaked slimes slow down, shrink and lose {sprayDps} HP/s. {sprayTankSeconds} s of water; empty, it refills in {sprayRefillSeconds} s."
    }
  ],

  // Desktop apps (Adventure, Expedition, Infinity; not free battles): five made-up app icons drawn
  // by the game (never a real app's name or logo) stand on random desktop cells above the strip.
  // Each charges in "charge" s of battle ("start" at the start, else startCharge; killCharge more per defeated
  // enemy); a charged icon glows and a click sends its help down to the field. From a threat of
  // infectMinThreat each wave rolls infectChance for a slime to shoot a virus at an icon (at most
  // maxInfected); an elite slime with "virusEvery" also shoots (at most eliteVirusPerWave a wave). The
  // infected icon works against the cat (every *Every s: adCount ads that cannot be closed while it is
  // infected, a bell that stuns bellStun s, a freeze, a heal that guards the slime mendGuard s, an elite
  // spat out when spitElite) and crawls to a nearby cell every crawlEvery s, until clicked scrubClicks
  // times or its slime is defeated.
  // "list": one entry per app (tabs, ping, endtask, undo, trash, popup): desc = what it does,
  // bad = what it does once infected.
  "apps": {
    "startCharge": 0.2, "killCharge": 0.02,
    "tabSeconds": 6, "tabRadius": 70, "tabDamage": 14, "tabEvery": 0.5,
    "pingDamage": 14, "pingStun": 1.5, "pingTargets": 4, "endTaskShare": 0.25, "undoSeconds": 4, "trashCount": 2,
    "infectMinThreat": 1.3, "infectChance": 0.75, "maxInfected": 3, "scrubClicks": 5, "crawlEvery": 9, "eliteVirusPerWave": 2,
    "popupEvery": 8, "popupSeconds": 8, "popupSpawn": "slime", "adCount": 3,
    "bellEvery": 10, "bellDamage": 6, "bellStun": 1, "freezeEvery": 12, "freezeSeconds": 1.2,
    "mendEvery": 7, "mendShare": 0.15, "mendGuard": 2, "spitEvery": 15, "spitElite": true,
    // Malware at random times (from a threat of malwareMinThreat, every malwareEveryMin–malwareEveryMax s
    // of fighting, one kind by weight among those not out yet, at most maxMalware kinds at once).
    // Loading ring: the cat inside it is slowed; hold its spinner loadingHold s to close it. Forced
    // update: a wall between the cat and the slimes; the cat's hits speed it up, updateClicks clicks on
    // Later close it. Ads: adCount of them across the floor.
    "malwareMinThreat": 1.3, "malwareEveryMin": 15, "malwareEveryMax": 30, "maxMalware": 2, "adWeight": 1,
    "loadingWeight": 1, "loadingSeconds": 12, "loadingRadius": 85, "loadingSlow": 0.5, "loadingHold": 2,
    "updateWeight": 1, "updateSeconds": 8, "updateHitSeconds": 1.2, "updateClicks": 4,
    // virus.exe: a file on the desktop that copies itself; with 4 copies it infects an icon. Click to delete.
    "virusExeWeight": 1, "virusExeEvery": 6, "virusExeCopies": 4,
    "list": [
      { "id": "tabs", "nameVi": "Tab Lốc Xoáy", "nameEn": "Tab Tornado", "charge": 40, "start": 0.6,
        "descVi": "Ba thẻ tab bay xuống xoay quanh mèo 6 giây, chém slime ở gần.", "descEn": "Three tabs fly down and circle the cat for 6 s, cutting nearby slimes.",
        "badVi": "Nhiễm virus: bật 3 quảng cáo không tắt được tới khi gỡ virus khỏi Tab.", "badEn": "Infected: opens 3 ads that cannot be closed until the Tabs icon is cleaned." },
      { "id": "ping", "nameVi": "Bão Thông Báo", "nameEn": "Ping Storm", "charge": 55, "start": 0.4,
        "descVi": "Chuông 99+ rơi lên 4 slime gần mèo nhất: sát thương nhỏ, choáng 1,5 giây.", "descEn": "99+ bells drop on the 4 slimes nearest the cat: a little damage, 1.5 s stun.",
        "badVi": "Nhiễm virus: thả chuông lên đầu mèo, làm mèo choáng 1 giây.", "badEn": "Infected: drops bells on the cat's head that stun it for 1 s." },
      { "id": "endtask", "nameVi": "End Task", "nameEn": "End Task", "charge": 80,
        "descVi": "Tắt slime nhiều máu nhất. Trùm, tinh anh: mất 25% máu.", "descEn": "Ends the slime with the most HP. Bosses, elites: lose 25% HP.",
        "badVi": "Nhiễm virus: làm mèo \"Không phản hồi\" một lúc.", "badEn": "Infected: leaves the cat \"Not responding\" for a moment." },
      { "id": "undo", "nameVi": "Ctrl+Z", "nameEn": "Ctrl+Z", "charge": 90,
        "descVi": "Hoàn lại máu mèo mất trong 4 giây vừa qua.", "descEn": "Gives back the HP the cat lost in the last 4 s.",
        "badVi": "Nhiễm virus: hồi máu cho slime yếu nhất và che chắn nó 2 giây.", "badEn": "Infected: heals the weakest slime and guards it for 2 s." },
      { "id": "trash", "nameVi": "Thùng Rác", "nameEn": "Bin", "charge": 70,
        "descVi": "Hút 2 slime thường gần mèo nhất vào thùng.", "descEn": "Sucks the 2 plain slimes nearest the cat into the bin.",
        "badVi": "Nhiễm virus: nhả một slime tinh anh ra sàn.", "badEn": "Infected: spits an elite slime onto the floor." },
      { "id": "popup", "nameVi": "Quảng cáo", "nameEn": "Ad popup",
        "descVi": "Ba quảng cáo che slime phía sau. Bấm × để tắt (Tab nhiễm thì gỡ Tab trước); để lâu sẽ thả slime ra.", "descEn": "Three ads cover the slimes behind them. Click × to close (clean an infected Tabs first), or one lets a slime out." }
    ]
  },

  // Difficulty: multipliers on every enemy's HP, damage and speed (0.25–3). Normal is the
  // numbers in this file as they are.
  "easy": { "enemyHp": 0.65, "enemyDamage": 0.5, "enemySpeed": 0.85 },
  "hard": { "enemyHp": 1.3, "enemyDamage": 1.4, "enemySpeed": 1.15 },

  // Enemy kinds (family and renderer default to "slime"). scale: drawn size against the basic
  // slime (0.5–2.3); hitScale: combat size for reach and bombs (default: scale). boss: crown + HUD bar.
  // slam: area hit with a floor warning (slamDamage: its damage; default: damage). summonAt/enrageAt: HP fraction (0 = never).
  "enemies": [
    {
      "id": "slime", "nameVi": "Slime", "nameEn": "Slime",
      "maxHp": 58, "speed": 34, "damage": 12, "range": 64,
      "windup": 0.8, "attackCooldown": 1.8, "recover": 0.35,
      "scale": 1, "color": "#7CD36A", "cost": 1,
      // elite stats multiply once on top of difficulty and threat (attackCooldown: only the wait between attacks).
      // virusEvery: in battles with the desktop apps it shoots a virus at a clean icon that often.
      "elite": { "hp": 1.2, "attackCooldown": 0.65, "virusEvery": 25, "cost": 1, "descVi": "máu dày, đánh dồn dập, bắn virus vào icon", "descEn": "more HP, attacks more often, shoots viruses at icons" }
    },
    {
      // Small and quick, falls fast. dash: within dashRange it winds up (its lane shows on the
      // floor), then lunges dashDistance at dashSpeed; running into the cat hits once and stuns it.
      "id": "runner", "nameVi": "Slime nhanh", "nameEn": "Quick slime",
      "maxHp": 28, "speed": 70, "damage": 7, "range": 54,
      "windup": 0.7, "attackCooldown": 2.6, "recover": 0.4,
      "scale": 0.75, "color": "#5CC8FF", "marks": "speed",
      "dash": true, "dashRange": 170, "dashDistance": 230, "dashSpeed": 420, "cost": 1,
      // hitAndRun: after a dash it runs this far away from the cat before coming back.
      "hitAndRun": 150,
      // elite: one affix it may roll when it spawns (gold rim and star): a longer windup, a faster dash.
      "elite": { "windupAdd": 0.3, "dashSpeed": 1.4, "damage": 1.2, "cost": 1, "descVi": "gồng lâu hơn, lao nhanh và đau hơn", "descEn": "longer windup, faster and harder dash" }
    },
    {
      // Big and slow: hard to push, hits hard; a job for Cheer and the yarn bomb. blockChance: each
      // sword/hammer hit may be blocked (never the bomb, never a combo with Armor break); after
      // blockMaxStreak blocks in a row the next hit always lands. blockFrontOnly: hits from behind
      // always land; turnSeconds: it needs that long to face the other way. blocker: the cat on the
      // floor cannot walk past it (it must defeat it, or be lifted over). Drawn wide and low, so its
      // hitScale is wider than its scale.
      "id": "rock", "nameVi": "Slime đá", "nameEn": "Rock slime",
      "maxHp": 188, "speed": 20, "damage": 18, "range": 72,
      "windup": 1.0, "attackCooldown": 2.4, "recover": 0.5,
      "scale": 1.35, "hitScale": 1.5, "color": "#A8A095", "marks": "cracks",
      "pushFactor": 0.5, "stunFactor": 0.6, "blockChance": 0.3, "blockMaxStreak": 2,
      "blocker": true, "blockFrontOnly": true, "turnSeconds": 2, "cost": 2,
      "elite": { "sureBlocks": 1, "hp": 1.3, "pushImmune": true, "cost": 1, "descVi": "chặn chắc đòn đầu, máu dày, miễn Đẩy", "descEn": "blocks its first front hit, more HP, no Push" }
    },
    {
      // Support: winds up a heal (its leaf glows) on the most hurt ally in healRange every healCooldown s;
      // healBudget caps all it can heal (amount and budget grow like enemy HP: difficulty × threat). A push or stun during the windup cancels it. support: while a
      // fighting ally is on the field it never attacks the cat and keeps keepBack DIPs behind it.
      // farHealBelow: with no hurt ally in reach, an ally below that share of its HP anywhere on the field
      // gets a heal all the same (farHealWindup s of windup, once per farHealCooldown s; a push cancels it).
      "id": "mender", "nameVi": "Slime thảo dược", "nameEn": "Herb slime",
      "maxHp": 46, "speed": 28, "damage": 5, "range": 56,
      "windup": 0.8, "attackCooldown": 2.0, "recover": 0.35,
      "scale": 0.9, "color": "#4FC9A8", "marks": "leaf",
      "healAmount": 35, "healRange": 170, "healCooldown": 3.15, "healWindup": 0.9, "healBudget": 210,
      "support": true, "keepBack": 110, "farHealBelow": 0.35, "farHealWindup": 1.2, "farHealCooldown": 8, "cost": 2,
      // healGuard: the ally it heals takes no damage during the windup (not a boss; the same ally again after
      // healGuardRepeat s); fleeSpeed: up to this × faster backing off from a close cat; hideBehindGuard: it

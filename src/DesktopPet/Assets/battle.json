{
  // Battle Mode data (DIPs and seconds). Embedded in the exe; a broken file is logged and
  // the built-in battle is used (same numbers; only plain slimes before the King).
  // Misspelt keys are rejected. To change it without rebuilding, put a battle.json with only
  // your changes in %LOCALAPPDATA%\DesktopPet (see docs/BATTLE-DATA.md).
  "schemaVersion": 1,
  "catMaxHp": 100,
  // The cat runs during a battle (walking speed and acceleration × this).
  "catRunScale": 1.8,
  // Combo: this many hits in a row (each within comboWindow s of the last) make the last one
  // a combo: damage × comboDamage and a knock-back (DIPs/s, × the enemy's pushFactor).
  "comboHits": 3,
  "comboWindow": 1.6,
  "comboDamage": 2,
  "comboKnock": 300,
  // The cat's weapons, in the order the battle setup panel shows them (the first one is the
  // default). style: the drawing ("sword" or "hammer"). range: centre-to-centre reach.
  // attackCooldown: from one swing to the next; hitTime: the one moment in the swing that hits.
  // knock: every hit sends the slime back (DIPs/s × its pushFactor, no stun); 0 = only combos do.
  "weapons": [
    {
      "id": "sword", "nameVi": "Kiếm", "nameEn": "Sword", "style": "sword", "hitEffect": "spark",
      "hintVi": "nhanh, dễ nối combo", "hintEn": "fast, easy combos",
      "damage": 25, "range": 76, "attackCooldown": 0.75, "swingDuration": 0.36, "hitTime": 0.16, "knock": 0
    },
    {
      "id": "hammer", "nameVi": "Búa", "nameEn": "Hammer", "style": "hammer", "hitEffect": "thud",
      "hintVi": "chậm, mạnh, đẩy lùi mỗi nhát", "hintEn": "slow, heavy, knocks back every hit",
      "damage": 45, "range": 76, "attackCooldown": 1.35, "swingDuration": 0.7, "hitTime": 0.45, "knock": 170
    }
  ],

  "slimeWidth": 46,
  "slimeHeight": 34,
  "spawnDuration": 0.5,
  "defeatDuration": 0.6,
  "maxAlive": 3,
  "spawnInterval": 1.6,
  "firstWaveDelay": 1.5,
  "waveBreakSeconds": 3.5,
  "waveHeal": 15,
  "spawnMinDistance": 200,
  // Putting a lifted cat down protects it this long (0–5 s), at most once per
  // rescueGraceCooldownSeconds (0–60) of the cat on the ground in a running battle, and only after
  // a lift of at least rescueGraceMinLiftSeconds (0–2; a quick lift-and-drop earns none).
  "landingGraceSeconds": 1.5,
  "rescueGraceCooldownSeconds": 5,
  "rescueGraceMinLiftSeconds": 0.3,
  // A dashing slime that runs into the cat stuns it (stars over its head; it stands still and does
  // not swing, but can still be lifted and thrown). After a stun, no new one for stunImmunitySeconds.
  "stunDurationSeconds": 1.5,
  "stunImmunitySeconds": 3,
  // Attack turns: at most maxAttackers enemies wind up or dash at once (0: no limit) and a new windup
  // starts at least attackStagger s after the last (the boss never waits). incomingWarning: seconds
  // an arrow shows at an edge before a spawn from behind (two-sided waves, "side": "b").
  "maxAttackers": 2,
  "attackStagger": 0.3,
  "incomingWarning": 1,
  // Enemy Director: at most maxElites elite enemies alive at once (a stage's eliteChance rolls them,
  // never on Easy); rareChance: how often a group's rare card takes its common card's place.
  "maxElites": 1,
  "rareChance": 0.15,
  "outroSeconds": 3,
  "hurtFlashSeconds": 0.35,
  "maxEffects": 32,

  // The user's skills.
  "pushCooldown": 5,
  "pushSpeed": 520,
  "pushStunSeconds": 1.4,
  "healCooldown": 20,
  "healAmount": 25,
  "cheerCooldown": 18,
  "cheerSeconds": 5,
  "cheerSpeed": 1.6,
  "cheerDamage": 1.4,
  "bombCooldown": 12,
  "bombDelay": 0.5,
  "bombDamage": 30,
  "bombRadius": 70,
  "shieldCooldown": 15,
  "shieldSeconds": 3,

  // Difficulty: multipliers on every enemy's HP, damage and speed (0.25–3). Normal is the
  // numbers in this file as they are.
  "easy": { "enemyHp": 0.65, "enemyDamage": 0.5, "enemySpeed": 0.85 },
  "hard": { "enemyHp": 1.3, "enemyDamage": 1.4, "enemySpeed": 1.15 },

  // Enemy kinds (family and renderer default to "slime"). scale: drawn size against the basic
  // slime (0.5–2.3); hitScale: combat size for reach and bombs (default: scale). boss: crown + HUD bar.
  // slam: area hit with a floor warning. summonAt/enrageAt: HP fraction (0 = never).
  "enemies": [
    {
      "id": "slime", "nameVi": "Slime", "nameEn": "Slime",
      "maxHp": 58, "speed": 34, "damage": 12, "range": 64,
      "windup": 0.8, "attackCooldown": 1.8, "recover": 0.35,
      "scale": 1, "color": "#7CD36A", "cost": 1,
      // elite stats multiply once on top of difficulty and threat (attackCooldown: only the wait between attacks).
      "elite": { "hp": 1.2, "attackCooldown": 0.65, "cost": 1, "descVi": "máu dày hơn, đánh dồn dập hơn", "descEn": "more HP, attacks more often" }
    },
    {
      // Small and quick, falls fast. dash: within dashRange it winds up (its lane shows on the
      // floor), then lunges dashDistance at dashSpeed; running into the cat hits once and stuns it.
      "id": "runner", "nameVi": "Slime nhanh", "nameEn": "Quick slime",
      "maxHp": 28, "speed": 70, "damage": 7, "range": 54,
      "windup": 0.7, "attackCooldown": 2.6, "recover": 0.4,
      "scale": 0.75, "color": "#5CC8FF", "marks": "speed",
      "dash": true, "dashRange": 170, "dashDistance": 230, "dashSpeed": 420, "cost": 1,
      // hitAndRun: after a dash it runs this far away from the cat before coming back.
      "hitAndRun": 150,
      // elite: one affix it may roll when it spawns (gold rim and star): a longer windup, a faster dash.
      "elite": { "windupAdd": 0.3, "dashSpeed": 1.4, "damage": 1.2, "cost": 1, "descVi": "gồng lâu hơn, lao nhanh và đau hơn", "descEn": "longer windup, faster and harder dash" }
    },
    {
      // Big and slow: hard to push, hits hard; a job for Cheer and the yarn bomb. blockChance: each
      // sword/hammer hit may be blocked (never the bomb, never a combo with Armor break); after
      // blockMaxStreak blocks in a row the next hit always lands. blockFrontOnly: hits from behind
      // always land; turnSeconds: it needs that long to face the other way. blocker: the cat on the
      // floor cannot walk past it (it must defeat it, or be lifted over). Drawn wide and low, so its
      // hitScale is wider than its scale.
      "id": "rock", "nameVi": "Slime đá", "nameEn": "Rock slime",
      "maxHp": 188, "speed": 20, "damage": 18, "range": 72,
      "windup": 1.0, "attackCooldown": 2.4, "recover": 0.5,
      "scale": 1.35, "hitScale": 1.5, "color": "#A8A095", "marks": "cracks",
      "pushFactor": 0.5, "stunFactor": 0.6, "blockChance": 0.3, "blockMaxStreak": 2,
      "blocker": true, "blockFrontOnly": true, "turnSeconds": 0.6, "cost": 2,
      "elite": { "sureBlocks": 1, "hp": 1.3, "pushImmune": true, "cost": 1, "descVi": "chặn chắc đòn đầu, máu dày, miễn Đẩy", "descEn": "blocks its first front hit, more HP, no Push" }
    },
    {
      // Support: winds up a heal (its leaf glows) on the most hurt ally in healRange every healCooldown s;
      // healBudget caps all it can heal (amount and budget grow like enemy HP: difficulty × threat). A push or stun during the windup cancels it. support: while a
      // fighting ally is on the field it never attacks the cat and keeps keepBack DIPs behind it.
      // farHealBelow: with no hurt ally in reach, an ally below that share of its HP anywhere on the field
      // gets a heal all the same (farHealWindup s of windup, once per farHealCooldown s; a push cancels it).
      "id": "mender", "nameVi": "Slime thảo dược", "nameEn": "Herb slime",
      "maxHp": 46, "speed": 28, "damage": 5, "range": 56,
      "windup": 0.8, "attackCooldown": 2.0, "recover": 0.35,
      "scale": 0.9, "color": "#4FC9A8", "marks": "leaf",
      "healAmount": 35, "healRange": 170, "healCooldown": 3.15, "healWindup": 0.9, "healBudget": 210,
      "support": true, "keepBack": 110, "farHealBelow": 0.35, "farHealWindup": 1.2, "farHealCooldown": 8, "cost": 2,
      // healGuard: the ally it heals takes no damage during the windup (not a boss; the same ally again after
      // healGuardRepeat s); fleeSpeed: up to this × faster backing off from a close cat; hideBehindGuard: it
      // keeps behind its guard rock.
      "healGuard": true, "healGuardRepeat": 2, "fleeSpeed": 2.5, "hideBehindGuard": true,
      "elite": { "firstHeal": 2, "healCooldown": 0.85, "healBudget": 1.3, "cost": 1, "descVi": "hồi đầu gấp đôi, hồi nhanh và nhiều hơn", "descEn": "first heal doubled, heals sooner and longer" }
    },
    {
      // The chapter 1 boss (Adventure stage 5): the free battle keeps "king" below. Phases fire once
      // each at their HP fraction; at most summonCap helpers alive at once. A shield phase stops a
      // hit at its line, runs to the far edge (retreatSpeed, at most retreatSeconds), calls its
      // helpers there and takes no damage until they are all defeated. rallyEvery: meanwhile its crown
      // glows (rallyCharge s; a push cuts it) and one fighting helper becomes elite for good: rallyHp more
      // max HP, hits × rallyDamage and its kind's own elite affix.
      // shieldBreakStun: dazed that long when the shield breaks. retreatLeap: instead of running it crouches
      // (leapCrouch s) and leaps (leapSeconds) to the edge opposite its half of the floor (the other one if
      // the cat is in that half); summonWarning: purple rings show where its helpers appear, that long before.
      "id": "king_c1", "nameVi": "Vua Slime", "nameEn": "Slime King",
      "maxHp": 720, "speed": 22, "damage": 30, "range": 110,
      "windup": 1.2, "attackCooldown": 2.6, "recover": 0.7,
      "scale": 2, "color": "#9B7BE0", "angryColor": "#E86A6A",
      "boss": true, "slam": true, "pushFactor": 0.35, "stunFactor": 0.4,
      "enragedSpeed": 32, "enragedWindup": 0.8, "summonCap": 4, "retreatSpeed": 240, "retreatSeconds": 3,
      "rallyEvery": 10, "rallyCharge": 0.8, "rallyHp": 0.5, "rallyDamage": 1.25, "shieldBreakStun": 2,
      "retreatLeap": true, "leapCrouch": 0.35, "leapSeconds": 0.9, "summonWarning": 0.6,
      "phases": [
        { "at": 0.75, "shield": true, "summons": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 1 } ] },
        { "at": 0.5, "shield": true, "summons": [ { "enemy": "mender", "count": 1 }, { "enemy": "rock", "count": 1 }, { "enemy": "runner", "count": 1 } ] },
        { "at": 0.25, "shield": true, "enrage": true, "summons": [ { "enemy": "mender", "count": 1 }, { "enemy": "rock", "count": 1 }, { "enemy": "slime", "count": 2 } ] }
      ]
    },
    {
      "id": "king", "nameVi": "Vua Slime", "nameEn": "Slime King",
      "maxHp": 480, "speed": 22, "damage": 30, "range": 110,
      "windup": 1.2, "attackCooldown": 2.6, "recover": 0.7,
      "scale": 2, "color": "#9B7BE0", "angryColor": "#E86A6A",
      "boss": true, "slam": true, "pushFactor": 0.35, "stunFactor": 0.4,
      "summonAt": 0.5, "summonCount": 2, "summonType": "slime",
      "enrageAt": 0.3, "enragedSpeed": 32, "enragedWindup": 0.8
    }
  ],

  // Waves in order; each wave's groups spawn in order. A group is "enemy" × "count", or "pick":
  // { kind: weight } drawn count times when the wave starts (with "atLeast": { kind: n } guaranteed),
  // or "squad": [ { enemy, count } ] coming together (supports behind the fighters) once the floor has
  // room for all of it. "side" (two-sided waves): "a" comes from the edge far from the cat, "b" from
  // the other edge after a warning arrow. "threat" (Adventure only): this wave's enemies are that much stronger.
  // HP × threat, damage × only threatDamageShare of the rise; worked out once when an enemy appears.
  "threatDamageShare": 0.5,
  "waves": [
    { "groups": [ { "enemy": "slime", "count": 2 } ] },
    { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 2 } ] },
    { "groups": [ { "enemy": "rock", "count": 1 }, { "enemy": "runner", "count": 2 }, { "enemy": "slime", "count": 2 } ] },
    { "groups": [ { "enemy": "king", "count": 1 } ] }
  ],

  // Adventure upgrades: after a cleared wave (when another follows) a stage with "upgrades": true
  // offers up to 3 of these, one from each group while a group has any left; the user takes one.
  // The build carries on: winning a stage passes it to the next stage (a free battle starts
  // without one). effect: damage, moveSpeed, attackSpeed (less time between swings) and armor
  // (less damage taken) take a fraction (0.2 = 20 %); knock: extra knock-back on every hit
  // (DIPs/s); maxHp: more max HP (and that much HP at once); heal: HP at once (never offered at
  // full HP; it takes the place of the group card the build has least of). maxStacks: how often one
  // build may take it (0 = no limit). group: defense, power or speed (a heal has none).
  "upgrades": [
    { "id": "sharp", "group": "power", "nameVi": "Sắc bén", "nameEn": "Sharp edge", "descVi": "+20% sát thương", "descEn": "+20% damage", "effect": "damage", "amount": 0.2, "maxStacks": 3 },
    { "id": "quick_feet", "group": "speed", "nameVi": "Nhanh chân", "nameEn": "Quick feet", "descVi": "+15% tốc độ chạy", "descEn": "+15% running speed", "effect": "moveSpeed", "amount": 0.15, "maxStacks": 2 },
    { "id": "fast_paws", "group": "speed", "nameVi": "Ra đòn nhanh", "nameEn": "Fast paws", "descVi": "−12% thời gian hồi đòn", "descEn": "−12% time between swings", "effect": "attackSpeed", "amount": 0.12, "maxStacks": 3 },
    { "id": "heavy_push", "group": "power", "nameVi": "Đẩy mạnh", "nameEn": "Heavy push", "descVi": "Mỗi nhát đẩy slime lùi thêm", "descEn": "Every hit knocks slimes further", "effect": "knock", "amount": 80, "maxStacks": 2 },
    { "id": "grilled_fish", "nameVi": "Cá nướng", "nameEn": "Grilled fish", "descVi": "Hồi ngay 30 HP", "descEn": "Get 30 HP back now", "effect": "heal", "amount": 30, "maxStacks": 0 },
    { "id": "thick_fur", "group": "defense", "nameVi": "Lông dày", "nameEn": "Thick fur", "descVi": "−15% sát thương nhận vào", "descEn": "−15% damage taken", "effect": "armor", "amount": 0.15, "maxStacks": 2 },
    { "id": "big_heart", "group": "defense", "nameVi": "Tim to", "nameEn": "Big heart", "descVi": "+20 HP tối đa (hồi luôn 20)", "descEn": "+20 max HP (and 20 HP now)", "effect": "maxHp", "amount": 20, "maxStacks": 2 },
    // Rare cards (one per group, maxStacks 1): with rareChance one takes its group's card's place.
    // shell: stops one whole hit, back after amount s; opener: the first landed hit on each enemy deals
    // amount more; momentum: a swing after a run of 140 DIPs deals amount more.
    { "id": "turtle_shell", "group": "defense", "rare": true, "nameVi": "Mai rùa", "nameEn": "Turtle shell", "descVi": "Chặn trọn 1 đòn, mọc lại sau 12 giây", "descEn": "Stops one whole hit, grows back in 12 s", "effect": "shell", "amount": 12, "maxStacks": 1 },
    { "id": "opening_strike", "group": "power", "rare": true, "nameVi": "Đòn mở màn", "nameEn": "Opening strike", "descVi": "Đòn đầu trúng mỗi quái ×2 sát thương", "descEn": "First hit on each enemy deals ×2", "effect": "opener", "amount": 1, "maxStacks": 1 },
    { "id": "running_start", "group": "speed", "rare": true, "nameVi": "Chạy đà", "nameEn": "Running start", "descVi": "Chạy một quãng rồi chém: +80% sát thương", "descEn": "Swing after a run: +80% damage", "effect": "momentum", "amount": 0.8, "maxStacks": 1 }
  ],

  // Synergies: a build holding "at" cards of a group switches the effect on for good.
  // thorns: amount of the damage the cat really takes goes back to the attacker. armorBreak: combo
  // hits deal amount more. echo: every "every"-th landed swing strikes again for amount × its damage.
  // Reflected and echoed hits never set off another bonus.
  "synergies": [
    { "id": "thorns", "group": "defense", "at": 3, "effect": "thorns", "amount": 0.35, "nameVi": "Giáp gai", "nameEn": "Thorns",
      "descVi": "Quái đánh trúng mèo nhận lại 35% sát thương", "descEn": "Enemies that hit the cat take 35% of it back" },
    { "id": "armor_break", "group": "power", "at": 3, "effect": "armorBreak", "amount": 0.3, "nameVi": "Phá giáp", "nameEn": "Armor break",
      "descVi": "Đòn combo +30% sát thương, xuyên giáp đá", "descEn": "Combo hits deal 30% more and pierce stone" },
    { "id": "afterimage", "group": "speed", "at": 3, "effect": "echo", "amount": 0.5, "every": 4, "nameVi": "Dư ảnh", "nameEn": "Afterimage",
      "descVi": "Cứ 4 đòn trúng, thêm một đòn 50%", "descEn": "Every 4th hit strikes again for 50%" }
  ],

  // Adventure: chapters of stages played in order (winning a stage opens the next one). Stage ids
  // are stable: saved progress uses them. objective: "clear" (defeat every wave) or "survive" (stay
  // alive surviveSeconds; the last wave comes again while time is left). upgrades: offer upgrade
  // cards between waves. reward: an accessory (accessories.json, with "reward") given the first time
  // the stage is won. maxAlive: enemies
  // on the floor at once (default: the battle's). rulesVersion: raise it when a stage changes so much
  // that its old records should not be compared. threat: the stage's enemies are that much stronger
  // (× the wave's). A survive stage's last wave may be a "stream" (one kind drawn from "weights"
  // whenever there is room, every "interval" s at the start down to "intervalEnd" at the end), with
  // "threatGrowth" (threat added per minute held out) and "upgradeAt" (card offers at those seconds
  // of the clock instead of after waves). eliteChance: an enemy a wave or stream sends with an "elite"
  // affix is elite with this chance (not on Easy; maxElites alive at once). budget (a wave's or a
  // stream's): the most its enemies may cost ("cost"), elites included. See docs/BATTLE-DATA.md.
  "campaign": {
    "chapters": [
      {
        "id": "slime_invasion", "nameVi": "Cuộc xâm nhập của Slime", "nameEn": "The Slime Invasion",
        "stages": [
          {
            "id": "c1_first_steps", "nameVi": "Làm quen", "nameEn": "First steps",
            "goalVi": "Dọn 2 đợt slime dễ: click slime để chọn mục tiêu.", "goalEn": "Clear 2 waves of easy slimes: click a slime to pick the target.",
            "objective": "clear", "maxAlive": 2, "rulesVersion": 5,
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 2 } ] },
              { "groups": [ { "pick": { "slime": 3, "runner": 1 }, "count": 3, "atLeast": { "runner": 1 } } ] }
            ]
          },
          {
            "id": "c1_break_through", "nameVi": "Giải vây", "nameEn": "Break through",
            "goalVi": "Quái hỗn hợp: dùng kỹ năng, kéo mèo ra khi slime gồng đòn, chọn nâng cấp giữa các đợt.",
            "goalEn": "Mixed slimes: use skills, lift the cat when a slime winds up, pick upgrades between waves.",
            "tipVi": "Dọn xong một đợt, bạn chọn 1 trong 3 thẻ nâng cấp. Thắng màn thì build được mang sang màn sau. Slime đá chặn được đòn: đánh tiếp hoặc dùng Bom len.",
            "tipEn": "After each cleared wave, pick 1 of 3 upgrade cards. Win the stage and the build comes along to the next one. Rock slimes block some hits: keep at it or use the Yarn bomb.",
            "objective": "clear", "upgrades": true, "threat": 1.6, "rulesVersion": 11,
            "waves": [
              { "groups": [ { "enemy": "rock", "count": 1 }, { "pick": { "slime": 1, "runner": 1 }, "count": 2 } ] },
              { "groups": [ { "enemy": "rock", "count": 1 }, { "pick": { "slime": 1, "runner": 1 }, "count": 2 }, { "enemy": "rock", "count": 1 } ] },
              { "threat": 1.1, "groups": [ { "enemy": "rock", "count": 2 }, { "pick": { "slime": 1, "runner": 1 }, "count": 3 } ] }
            ]
          },
          {
            "id": "c1_hold_on", "nameVi": "Cầm cự", "nameEn": "Hold on",
            "goalVi": "Sống sót 75 giây: biết lúc đánh và lúc giữ máu. Bế mèo thì đồng hồ dừng.",
            "goalEn": "Survive 75 seconds: know when to attack and when to save HP. Carrying the cat stops the clock.",
            "tipVi": "Quái kéo tới liên tục và mạnh dần tới khi hết giờ. Ở giây 20, 40, 60 bạn chọn thẻ. Bế mèo thì đồng hồ dừng, nên hãy giữ HP bằng Khiên và Cá hồi máu.",
            "tipEn": "Slimes keep coming, stronger and stronger, until time is up. At 20, 40 and 60 s you pick a card. Carrying the cat stops the clock, so keep HP up with the Shield and the fish.",
            "objective": "survive", "surviveSeconds": 75, "maxAlive": 4, "upgrades": true, "maxUpgrades": 3, "upgradeAt": [ 20, 40, 60 ],
            "threatGrowth": 0.3, "threat": 1.7, "eliteChance": 0.3, "rulesVersion": 12, "reward": "SlimeHat",
            "waves": [
              { "stream": { "weights": { "runner": 2, "slime": 1, "rock": 1 }, "interval": 2.6, "intervalEnd": 1.4, "pincerAfter": 45, "budget": 7 } }
            ]
          },
          {
            "id": "c1_cut_support", "nameVi": "Cắt viện trợ", "nameEn": "Cut the support",
            "goalVi": "Slime thảo dược hồi máu cho đồng đội: hạ nó trước, hoặc Đẩy để cắt lúc nó gồng.",
            "goalEn": "Herb slimes heal their friends: take them down first, or Push one to cut its heal.",
            "tipVi": "Slime thảo dược (mũ lá) đứng sau slime đá và hồi máu cho đồng đội. Lá sáng lên là nó đang gồng: Đẩy để cắt. Đá chặn đường: hạ đá, hoặc bế mèo thả ra sau.",
            "tipEn": "Herb slimes (leaf caps) hide behind rock slimes and heal them. A glowing leaf means a heal is coming: Push to cut it. Rocks block the way: break them, or carry the cat behind.",
            "objective": "clear", "upgrades": true, "maxAlive": 5, "threat": 1.8, "eliteChance": 0.3, "rulesVersion": 13,
            "waves": [
              { "groups": [ { "pick": { "slime": 1, "runner": 1 }, "count": 3 } ] },
              { "budget": 9, "groups": [ { "squad": [ { "enemy": "mender", "count": 1 }, { "enemy": "rock", "count": 3 } ] } ] },
              { "budget": 10, "groups": [ { "pick": { "slime": 1, "runner": 1 }, "count": 1 }, { "squad": [ { "enemy": "mender", "count": 1 }, { "enemy": "rock", "count": 3 } ] } ] }
            ]

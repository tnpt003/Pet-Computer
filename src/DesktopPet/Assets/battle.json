{
  // Battle Mode data (DIPs and seconds). Embedded in the exe; a broken file is logged and
  // the built-in battle is used (same numbers; only plain slimes before the King).
  // Misspelt keys are rejected. To change it without rebuilding, put a battle.json with only
  // your changes in %LOCALAPPDATA%\DesktopPet (see docs/BATTLE-DATA.md).
  "schemaVersion": 1,
  "catMaxHp": 100,
  // The cat runs during a battle (walking speed and acceleration × this).
  "catRunScale": 1.8,
  // Combo: this many hits in a row (each within comboWindow s of the last) make the last one
  // a combo: damage × comboDamage and a knock-back (DIPs/s, × the enemy's pushFactor).
  "comboHits": 3,
  "comboWindow": 1.6,
  "comboDamage": 2,
  "comboKnock": 300,
  // The cat's weapons, in the order the battle setup panel shows them (the first one is the
  // default). style: the drawing ("sword" or "hammer"). range: centre-to-centre reach.
  // attackCooldown: from one swing to the next; hitTime: the one moment in the swing that hits.
  // knock: every hit sends the slime back (DIPs/s × its pushFactor, no stun); 0 = only combos do.
  "weapons": [
    {
      "id": "sword", "nameVi": "Kiếm", "nameEn": "Sword", "style": "sword", "hitEffect": "spark",
      "hintVi": "nhanh, dễ nối combo", "hintEn": "fast, easy combos",
      "damage": 25, "range": 76, "attackCooldown": 0.75, "swingDuration": 0.36, "hitTime": 0.16, "knock": 0
    },
    {
      "id": "hammer", "nameVi": "Búa", "nameEn": "Hammer", "style": "hammer", "hitEffect": "thud",
      "hintVi": "chậm, mạnh, đẩy lùi mỗi nhát", "hintEn": "slow, heavy, knocks back every hit",
      "damage": 45, "range": 76, "attackCooldown": 1.35, "swingDuration": 0.7, "hitTime": 0.45, "knock": 170
    }
  ],

  "slimeWidth": 46,
  "slimeHeight": 34,
  "spawnDuration": 0.5,
  "defeatDuration": 0.6,
  "maxAlive": 3,
  "spawnInterval": 1.6,
  "firstWaveDelay": 1.5,
  "waveBreakSeconds": 3.5,
  "waveHeal": 15,
  "spawnMinDistance": 200,
  // Putting a lifted cat down protects it this long (0–5 s), at most once per
  // rescueGraceCooldownSeconds (0–60) of the cat on the ground in a running battle.
  "landingGraceSeconds": 1.5,
  "rescueGraceCooldownSeconds": 5,
  "outroSeconds": 3,
  "hurtFlashSeconds": 0.35,
  "maxEffects": 32,

  // The user's skills.
  "pushCooldown": 5,
  "pushSpeed": 520,
  "pushStunSeconds": 1.4,
  "healCooldown": 20,
  "healAmount": 25,
  "cheerCooldown": 18,
  "cheerSeconds": 5,
  "cheerSpeed": 1.6,
  "cheerDamage": 1.4,
  "bombCooldown": 12,
  "bombDelay": 0.5,
  "bombDamage": 30,
  "bombRadius": 70,
  "shieldCooldown": 15,
  "shieldSeconds": 3,

  // Difficulty: multipliers on every enemy's HP, damage and speed (0.25–3). Normal is the
  // numbers in this file as they are.
  "easy": { "enemyHp": 0.75, "enemyDamage": 0.6, "enemySpeed": 0.85 },
  "hard": { "enemyHp": 1.3, "enemyDamage": 1.4, "enemySpeed": 1.15 },

  // Enemy kinds (family and renderer default to "slime"). scale: drawn size against the basic
  // slime (0.5–2.3); hitScale: combat size for reach and bombs (default: scale). boss: crown + HUD bar.
  // slam: area hit with a floor warning. summonAt/enrageAt: HP fraction (0 = never).
  "enemies": [
    {
      "id": "slime", "nameVi": "Slime", "nameEn": "Slime",
      "maxHp": 50, "speed": 34, "damage": 10, "range": 64,
      "windup": 0.8, "attackCooldown": 1.8, "recover": 0.35,
      "scale": 1, "color": "#7CD36A"
    },
    {
      // Small and quick: reaches the cat first, hits lightly, falls fast.
      "id": "runner", "nameVi": "Slime nhanh", "nameEn": "Quick slime",
      "maxHp": 25, "speed": 70, "damage": 6, "range": 54,
      "windup": 0.6, "attackCooldown": 1.4, "recover": 0.3,
      "scale": 0.75, "color": "#5CC8FF", "marks": "speed"
    },
    {
      // Big and slow: hard to push, hits hard; a job for Cheer and the yarn bomb.
      "id": "rock", "nameVi": "Slime đá", "nameEn": "Rock slime",
      "maxHp": 110, "speed": 20, "damage": 16, "range": 72,
      "windup": 1.0, "attackCooldown": 2.4, "recover": 0.5,
      "scale": 1.35, "color": "#A8A095", "marks": "cracks",
      "pushFactor": 0.5, "stunFactor": 0.6
    },
    {
      // Support: winds up a heal (green "+") on the most hurt ally in healRange every healCooldown s;
      // healBudget caps all it can heal. A push or stun during the windup cancels it.
      "id": "mender", "nameVi": "Slime thảo dược", "nameEn": "Herb slime",
      "maxHp": 40, "speed": 28, "damage": 5, "range": 56,
      "windup": 0.8, "attackCooldown": 2.0, "recover": 0.35,
      "scale": 0.9, "color": "#4FC9A8", "marks": "cross",
      "healAmount": 15, "healRange": 170, "healCooldown": 4.5, "healWindup": 1.0, "healBudget": 90
    },
    {
      // The chapter 1 boss (Adventure stage 5): the free battle keeps "king" below. Phases fire once
      // each at their HP fraction; at most summonCap helpers alive at once.
      "id": "king_c1", "nameVi": "Vua Slime", "nameEn": "Slime King",
      "maxHp": 450, "speed": 22, "damage": 25, "range": 110,
      "windup": 1.2, "attackCooldown": 2.6, "recover": 0.7,
      "scale": 2, "color": "#9B7BE0", "angryColor": "#E86A6A",
      "boss": true, "slam": true, "pushFactor": 0.35, "stunFactor": 0.4,
      "enragedSpeed": 32, "enragedWindup": 0.8, "summonCap": 4,
      "phases": [
        { "at": 0.75, "summon": "slime", "count": 2 },
        { "at": 0.5, "summon": "mender", "count": 1 },
        { "at": 0.4, "summon": "runner", "count": 2 },
        { "at": 0.3, "enrage": true }
      ]
    },
    {
      "id": "king", "nameVi": "Vua Slime", "nameEn": "Slime King",
      "maxHp": 400, "speed": 22, "damage": 25, "range": 110,
      "windup": 1.2, "attackCooldown": 2.6, "recover": 0.7,
      "scale": 2, "color": "#9B7BE0", "angryColor": "#E86A6A",
      "boss": true, "slam": true, "pushFactor": 0.35, "stunFactor": 0.4,
      "summonAt": 0.5, "summonCount": 2, "summonType": "slime",
      "enrageAt": 0.3, "enragedSpeed": 32, "enragedWindup": 0.8
    }
  ],

  // Waves in order; each wave's groups spawn in order.
  "waves": [
    { "groups": [ { "enemy": "slime", "count": 2 } ] },
    { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 2 } ] },
    { "groups": [ { "enemy": "rock", "count": 1 }, { "enemy": "runner", "count": 2 }, { "enemy": "slime", "count": 2 } ] },
    { "groups": [ { "enemy": "king", "count": 1 } ] }
  ],

  // Adventure upgrades: after a cleared wave (when another follows) a stage with "upgrades": true
  // offers up to 3 of these; the user takes one for the rest of that run only. effect: damage,
  // moveSpeed, attackSpeed (less time between swings) and armor (less damage taken) take a fraction
  // (0.2 = 20 %); knock: extra knock-back on every hit (DIPs/s); heal: HP at once (never offered at
  // full HP). maxStacks: how often one run may take it (0 = no limit).
  "upgrades": [
    { "id": "sharp", "nameVi": "Sắc bén", "nameEn": "Sharp edge", "descVi": "+20% sát thương", "descEn": "+20% damage", "effect": "damage", "amount": 0.2, "maxStacks": 3 },
    { "id": "quick_feet", "nameVi": "Nhanh chân", "nameEn": "Quick feet", "descVi": "+15% tốc độ chạy", "descEn": "+15% running speed", "effect": "moveSpeed", "amount": 0.15, "maxStacks": 2 },
    { "id": "fast_paws", "nameVi": "Ra đòn nhanh", "nameEn": "Fast paws", "descVi": "−12% thời gian hồi đòn", "descEn": "−12% time between swings", "effect": "attackSpeed", "amount": 0.12, "maxStacks": 3 },
    { "id": "heavy_push", "nameVi": "Đẩy mạnh", "nameEn": "Heavy push", "descVi": "Mỗi nhát đẩy slime lùi thêm", "descEn": "Every hit knocks slimes further", "effect": "knock", "amount": 80, "maxStacks": 2 },
    { "id": "grilled_fish", "nameVi": "Cá nướng", "nameEn": "Grilled fish", "descVi": "Hồi ngay 30 HP", "descEn": "Get 30 HP back now", "effect": "heal", "amount": 30, "maxStacks": 0 },
    { "id": "thick_fur", "nameVi": "Lông dày", "nameEn": "Thick fur", "descVi": "−15% sát thương nhận vào", "descEn": "−15% damage taken", "effect": "armor", "amount": 0.15, "maxStacks": 2 }
  ],

  // Adventure: chapters of stages played in order (winning a stage opens the next one). Stage ids
  // are stable: saved progress uses them. objective: "clear" (defeat every wave) or "survive" (stay
  // alive surviveSeconds; the last wave comes again while time is left). upgrades: offer upgrade
  // cards between waves. reward: an accessory (accessories.json, with "reward") given the first time
  // the stage is won. maxAlive: enemies
  // on the floor at once (default: the battle's). rulesVersion: raise it when a stage changes so much
  // that its old records should not be compared. See docs/BATTLE-DATA.md.
  "campaign": {
    "chapters": [
      {
        "id": "slime_invasion", "nameVi": "Cuộc xâm nhập của Slime", "nameEn": "The Slime Invasion",
        "stages": [
          {
            "id": "c1_first_steps", "nameVi": "Làm quen", "nameEn": "First steps",
            "goalVi": "Dọn 2 đợt slime dễ: click slime để chọn mục tiêu.", "goalEn": "Clear 2 waves of easy slimes: click a slime to pick the target.",
            "objective": "clear", "maxAlive": 2,
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 2 } ] },
              { "groups": [ { "enemy": "slime", "count": 3 } ] }
            ]
          },
          {
            "id": "c1_break_through", "nameVi": "Giải vây", "nameEn": "Break through",
            "goalVi": "Quái hỗn hợp: dùng kỹ năng, kéo mèo ra khi slime gồng đòn, chọn nâng cấp giữa các đợt.",
            "goalEn": "Mixed slimes: use skills, lift the cat when a slime winds up, pick upgrades between waves.",
            "tipVi": "Dọn xong một đợt, bạn chọn 1 trong 3 thẻ nâng cấp. Thẻ chỉ có tác dụng trong lượt chơi này; chơi lại thì bắt đầu từ đầu.",
            "tipEn": "After each cleared wave, pick 1 of 3 upgrade cards. They last for this run only; playing again starts fresh.",
            "objective": "clear", "upgrades": true, "rulesVersion": 2,
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 1 } ] },
              { "groups": [ { "enemy": "runner", "count": 2 }, { "enemy": "slime", "count": 2 } ] },
              { "groups": [ { "enemy": "rock", "count": 1 }, { "enemy": "slime", "count": 2 } ] }
            ]
          },
          {
            "id": "c1_hold_on", "nameVi": "Cầm cự", "nameEn": "Hold on",
            "goalVi": "Sống sót 75 giây: biết lúc đánh và lúc giữ máu. Bế mèo thì đồng hồ dừng.",
            "goalEn": "Survive 75 seconds: know when to attack and when to save HP. Carrying the cat stops the clock.",
            "tipVi": "Sống sót tới khi hết giờ. Bế mèo thì đồng hồ dừng, nên hãy giữ HP bằng Khiên và Cá hồi máu thay vì chờ trên tay.",
            "tipEn": "Stay alive until time is up. Carrying the cat stops the clock, so keep HP up with the Shield and the Healing fish instead.",
            "objective": "survive", "surviveSeconds": 75, "maxAlive": 4, "upgrades": true, "rulesVersion": 3, "reward": "SlimeHat",
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 3 }, { "enemy": "runner", "count": 1 } ] },
              { "groups": [ { "enemy": "rock", "count": 1 }, { "enemy": "runner", "count": 2 } ] },
              { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 2 }, { "enemy": "rock", "count": 1 } ] }
            ]
          },
          {
            "id": "c1_cut_support", "nameVi": "Cắt viện trợ", "nameEn": "Cut the support",
            "goalVi": "Slime thảo dược hồi máu cho đồng đội: hạ nó trước, hoặc Đẩy để cắt lúc nó gồng.",
            "goalEn": "Herb slimes heal their friends: take them down first, or Push one to cut its heal.",
            "tipVi": "Slime thảo dược (dấu +) hồi máu cho đồng đội. Thấy dấu + xanh trên đầu nó là nó đang gồng: Đẩy nó để cắt, hoặc click nó để mèo đánh nó trước.",
            "tipEn": "Herb slimes (with a +) heal their friends. A green + over one means it is winding up: Push it to cut the heal, or click it so the cat hits it first.",
            "objective": "clear", "upgrades": true, "rulesVersion": 3,
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "mender", "count": 1 } ] },
              { "groups": [ { "enemy": "rock", "count": 1 }, { "enemy": "mender", "count": 1 }, { "enemy": "runner", "count": 2 } ] },
              { "groups": [ { "enemy": "rock", "count": 1 }, { "enemy": "mender", "count": 1 }, { "enemy": "slime", "count": 2 } ] }
            ]
          },
          {
            "id": "c1_slime_king", "nameVi": "Vua Slime", "nameEn": "The Slime King",
            "goalVi": "Trận cuối chương: Vua Slime gọi quân theo từng pha, có cả slime thảo dược.",
            "goalEn": "The chapter's last battle: the Slime King calls help phase by phase, herb slimes too.",
            "tipVi": "Vua Slime gọi quân ở khoảng 75%, 50% và 40% máu, nổi giận ở 30%. Thấy vùng đỏ dưới sàn: kéo mèo ra ngoài hoặc bật Khiên.",
            "tipEn": "The Slime King calls help at about 75%, 50% and 40% HP and gets angry at 30%. A red zone on the floor: lift the cat out or use the Shield.",
            "objective": "clear", "upgrades": true, "rulesVersion": 3, "reward": "SlimeKingCrown",
            "waves": [
              { "groups": [ { "enemy": "slime", "count": 2 }, { "enemy": "runner", "count": 2 } ] },
              { "groups": [ { "enemy": "mender", "count": 1 }, { "enemy": "slime", "count": 2 } ] },
              { "groups": [ { "enemy": "king_c1", "count": 1 } ] }
            ]
          }
        ]
      }
    ]
  }
}

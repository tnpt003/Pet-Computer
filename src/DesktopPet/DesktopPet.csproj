<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Pet.ico</ApplicationIcon>
    <Version>1.4.2</Version>
    <Product>Desktop Pet</Product>
    <!-- Forms supplies only the tray icon; WPF owns startup and manifest DPI policy. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- The small heap does not need background GC; turning it off keeps ~25 MB less RAM (scripts/perf.ps1, 2026-10-16). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Everything that does not need WPF (model, physics, battle, data, Python bridge); it also
         embeds Assets/coats.json, accessories.json, battle.json, i18n/*.json and Sounds/*.wav. -->
    <ProjectReference Include="../DesktopPet.Core/DesktopPet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UiChecks set up battle views through their internal members instead of reflection. -->
    <InternalsVisibleTo Include="DesktopPet.UiChecks" />
  </ItemGroup>
  <ItemGroup>
    <!-- Installer and self-update from GitHub Releases (PetUpdates.cs, scripts/pack.ps1). -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Pet.ico" />
    <Content Include="Assets/Sounds/CREDITS.md;Assets/Sounds/sources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../ai/service.py;../../ai/speech.py;../../ai/learning.py;../../ai/seasons.py;../../ai/personality.json;../../ai/lines.json;../../ai/calendar.json">
      <Link>ai/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(BundlePython)' == 'true'">
    <Content Include="$(PythonRuntimeDir)/**/*" Exclude="$(PythonRuntimeDir)/**/__pycache__/**;$(PythonRuntimeDir)/**/*.pyc">
      <Link>python/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <Target Name="ValidateBundledPython" BeforeTargets="PrepareForPublish" Condition="'$(BundlePython)' == 'true'">
    <Error Condition="!Exists('$(PythonRuntimeDir)/python.exe') Or !Exists('$(PythonRuntimeDir)/python313.zip') Or !Exists('$(PythonRuntimeDir)/python313.dll') Or !Exists('$(PythonRuntimeDir)/LICENSE.txt')"
           Text="A complete Python 3.13 embedded runtime is required. Run scripts/publish.ps1 to prepare it, or set PythonRuntimeDir to its folder." />
  </Target>
</Project>
